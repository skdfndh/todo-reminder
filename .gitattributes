# 默认：仓库内统一使用 LF
* text=auto eol=lf

# Android / iOS 平台文件保留各自换行符
*.bat text eol=crlf
*.cmd text eol=crlf
*.gradle text eol=lf
*.kts text eol=lf

# 二进制文件：禁止换行符转换与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.jar binary
